# Base de datos (misma que el backend)
DB_HOST=db
DB_PORT=3306
DB_USER=pbxuser
DB_PASSWORD=tu_password_db
DB_NAME=asterisk_gui

# ARI de Asterisk
ARI_HOST=host.docker.internal
ARI_PORT=8088
ARI_USER=ariuser
ARI_PASSWORD=tu_ari_password
ARI_APP=voice-agent

# Troncal por defecto para llamadas salientes
ASTERISK_TRUNK=openvox

# IP de este contenedor accesible por Asterisk (host o IP del bridge pbx_net)
# Asterisk usará esta IP para enviar RTP
AGENT_RTP_HOST=10.10.10.20
RTP_PORT_START=10000
RTP_PORT_END=10100

# OpenAI
OPENAI_API_KEY=sk-...
